# SECURITY: Never commit secrets or generated files
.env

# Uploaded user content
public/uploads/profiles/*.png
public/uploads/profiles/*.jpg
public/uploads/profiles/*.gif
public/uploads/profiles/*.webp

# SSL certificates (generated at deploy time)
*.crt
*.key
*.pem

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
scripts/*
.env
.venv/

# Microsoft Office lock files (created when a file is open)
~$*.docx
~$*.xlsx
~$*.pptx

# Python cache
__pycache__/
*.pyc
*.pyo

# Generated report (re-generated by generate_report.py)
Team-08_Phase2_Report.docx
Transactiwar.docx
SECURITY_FEATURES.md
generate_report.py